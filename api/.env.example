# =============================================================================
# Variáveis da API — copie para .env no desenvolvimento local
# =============================================================================
# NENHUM valor real entra neste arquivo nem no repositório. No Render, elas são
# cadastradas em Environment; aqui ficam só os nomes.

# Postgres do Supabase. Use a string do POOLER (host com "pooler.supabase.com"),
# nunca a conexão direta: a direta só responde em IPv6 e o Render pode não
# alcançá-la — o erro parece credencial errada e custa horas.
DATABASE_URL=

# Projeto do Supabase, usados para validar o token do cliente.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Origem do Static Site, sem barra no fim. Aceita mais de uma, separadas por
# vírgula (útil para testar do localhost).
ORIGEM_PERMITIDA=https://barbeariasirpatrick.com.br

# Web Push. Gere o par com: npx web-push generate-vapid-keys
# A pública também vai em public/shared/config.js. A privada NUNCA sai daqui.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@barbeariasirpatrick.com.br

# E-mail transacional (Resend).
RESEND_API_KEY=
EMAIL_REMETENTE=Barbearia Sir. Patrick <agenda@barbeariasirpatrick.com.br>

# Emergência: 1 desliga o trabalhador da fila sem derrubar a API.
FILA_DESLIGADA=0
